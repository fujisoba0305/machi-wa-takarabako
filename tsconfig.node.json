{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "./node_modules/.cache/machi-config",
    "tsBuildInfoFile": "./node_modules/.cache/machi-config/build.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "dev/**/*.ts",
    "api/overpass.ts",
    "api/walking-trial-access.ts"
  ]
}
